generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String

  price           Int
  originalPrice   Int?
  discountPercent Int?

  images          String[]

  categorySlug    String

  rating          Float
  reviewCount     Int

  sold            Int
  stock           Int

  location        String

  shopName        String
  shopAvatar      String

  isFlashSale     Boolean  @default(false)
  flashSaleEndsAt DateTime?
  flashSaleStock  Int?
  flashSaleSold   Int?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique
  password  String

  fullName  String?
  avatar    String?

  role      String   @default("customer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}